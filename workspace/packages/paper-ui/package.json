{
  "name": "@studio-baeks/paper-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "paper-ui — a ledger for the screen. Paper, ink, and ruled lines.",
  "license": "MIT",
  "author": "Jaewon Baek",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./styles.css": "./dist/paper-ui.css"
  },
  "sideEffects": ["**/*.css", "**/*.css.ts"],
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist --noEmit false",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": { "@vanilla-extract/css": "^1.16.0" },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
