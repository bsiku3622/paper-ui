{
  "name": "@studio-baeks/paper-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "paper-ui — a ledger for the screen. Paper, ink, and ruled lines.",
  "license": "MIT",
  "author": "Jaewon Baek",
  "homepage": "https://github.com/bsiku3622/paper-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsiku3622/paper-ui.git",
    "directory": "workspace/packages/paper-ui"
  },
  "bugs": "https://github.com/bsiku3622/paper-ui/issues",
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "vanilla-extract",
    "typescript"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "paper-ui-source": "./src/index.ts",
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tokens": {
      "paper-ui-source": "./src/tokens/public.ts",
      "default": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      }
    },
    "./theme-boot": {
      "paper-ui-source": "./src/theme/boot.ts",
      "default": {
        "types": "./dist/theme-boot.d.ts",
        "default": "./dist/theme-boot.js"
      }
    },
    "./styles.css": {
      "paper-ui-source": "./src/styles/global.css.ts",
      "default": "./dist/paper-ui.css"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "browserslist": [
    "chrome >= 125",
    "edge >= 125",
    "firefox >= 121",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/tokens/inspect"
  ],
  "scripts": {
    "build": "eslint src --max-warnings 0 && tsc --noEmit && vite build && node scripts/build-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm -w run verify"
  },
  "dependencies": {
    "@react-aria/dnd": "^3.12.1",
    "@react-aria/focus": "^3.22.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/overlays": "^3.32.1",
    "@react-aria/visually-hidden": "^3.9.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
