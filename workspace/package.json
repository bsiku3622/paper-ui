{
  "name": "paper-ui-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @paper-ui/app dev",
    "build": "pnpm --filter @studio-baeks/paper-ui build && pnpm --filter @paper-ui/app build",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "lint": "eslint . --max-warnings 0 && eslint . -c eslint.paper.config.js --quiet",
    "test": "node scripts/check-contracts.mjs && node --test eslint-rules/*.test.js scripts/*.test.mjs && pnpm -r test",
    "test:e2e": "playwright test",
    "docs:sync": "pnpm --filter @paper-ui/app docs:sync",
    "docs:check": "pnpm --filter @paper-ui/app typecheck && pnpm --filter @paper-ui/app exec vitest --run src/docs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  }
}
