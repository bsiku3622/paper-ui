{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "customConditions": ["paper-ui-source"],
    "paths": {
      "@studio-baeks/paper-ui": ["../packages/paper-ui/src/index.ts"],
      "@studio-baeks/paper-ui/tokens": ["../packages/paper-ui/src/tokens/public.ts"],
      "@studio-baeks/paper-ui/theme-boot": ["../packages/paper-ui/src/theme/boot.ts"],
      "@paper-ui/inspect/*": ["../packages/paper-ui/src/tokens/inspect/*.ts"]
    }
  },
  "include": [".doc-snippets/**/*.tsx", "scripts/docs/snippet-scope.d.ts"]
}
