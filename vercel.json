{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install -g pnpm@11.0.9 && export PATH=\"$(npm prefix -g)/bin:$PATH\" && cd workspace && pnpm install --frozen-lockfile",
  "buildCommand": "export PATH=\"$(npm prefix -g)/bin:$PATH\" && cd workspace && pnpm build",
  "outputDirectory": "workspace/app/dist",
  "rewrites": [
    { "source": "/demos/(.*)", "destination": "/demos/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/demos/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
